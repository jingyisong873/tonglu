{
  "name": "tonglu",
  "version": "0.1.0",
  "private": true,
  "description": "Evidence-linked market research and reproducible scenario comparisons",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/server.mjs",
    "test": "node --test tests/market/*.test.ts tests/runtime/*.test.mjs",
    "test:core": "node --test tests/market/market.test.ts",
    "typecheck": "tsc --noEmit",
    "example": "node scripts/example.ts"
  },
  "dependencies": {
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jingyisong873/tonglu.git"
  },
  "bugs": {
    "url": "https://github.com/jingyisong873/tonglu/issues"
  },
  "homepage": "https://github.com/jingyisong873/tonglu#readme"
}
